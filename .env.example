# .env.example — Vorlage. Echte Keys liegen nur in .env (nicht in git).

# —— Umgebung ——————————————————————————————————————
# Wird für Sitemap, hreflang, Stripe-Redirect-URLs verwendet.
# Staging:    https://p-bn7b5m.project.space
# Production: https://kiehls-klunker.de
PUBLIC_SITE_URL=https://kiehls-klunker.de

# Optional: alle System-Mails auf eine einzige Adresse umleiten (für Staging/Tests).
# Wenn gesetzt, gehen Bestell- und Kontakt-Mails NICHT an die echten Empfänger
# sondern nur an diese Adresse. In Production LEER lassen.
EMAIL_OVERRIDE_TO=


# —— Etsy Open API v3 ——————————————————————————————
# Abrufbar im Etsy Developer Portal → deine App → App Details
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=

# OAuth 2.0 Tokens (werden nach einmaligem Login-Flow gesetzt)
ETSY_REFRESH_TOKEN=
ETSY_ACCESS_TOKEN=

# —— Stripe ————————————————————————————————————————
# Test-Keys aus dashboard.stripe.com/test/apikeys
# Live-Keys aus dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook-Signing-Secret (Stripe-Dashboard → Developers → Webhooks → Endpoint anlegen)
# Test-Modus und Live-Modus haben getrennte Secrets — beide werden hier getauscht!
STRIPE_WEBHOOK_SECRET=

# —— Kontaktformular ——————————————————————————————
# Resend (resend.com) — Domain verifizieren, dann Key hier eintragen
RESEND_API_KEY=
# Empfänger der Kundenanfragen
CONTACT_TO=info@kiehls-klunker.de
# Absender der System-Mails (muss auf einer in Resend verifizierten Domain liegen)
CONTACT_FROM_NAME=Kiehls Klunker
CONTACT_FROM_NOTIFICATION=formular@kiehls-klunker.de
CONTACT_FROM_CONFIRMATION=info@kiehls-klunker.de

# Cloudflare Turnstile (optional) — wenn leer, wird Captcha übersprungen
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
