---
export const prerender = true;

import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/images/ueber-mich-portrait.jpg';
import schmieden from '../assets/images/titan-schmieden.jpg';
---

<BaseLayout title="Über mich — Kiehls Klunker">
  <!-- Split 1+2: Editoriales Alternieren, eingefasst im Container -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-20">
    <section class="grid md:grid-cols-2 md:items-stretch">
      <div class="order-2 md:order-1 flex items-center py-12 md:py-20 md:pr-12 lg:pr-16">
        <div class="max-w-md mx-auto text-center md:text-left">
          <p class="eyebrow mb-4">Über mich</p>
          <h1 class="!text-[clamp(1.9rem,3.2vw,2.75rem)] mb-6">Kathrin Kiehl.<br />Seit 2016.</h1>
          <p class="text-[var(--color-ink-soft)] leading-relaxed mb-4">
            Seit 2016 entstehen in meiner Werkstatt die unterschiedlichsten Haarforken
            und Haarstäbe. Ursprünglich aus eigenem Interesse habe ich mich auf das Thema
            Haarschmuck spezialisiert und experimentiere mit verschiedenen Materialien,
            um daraus einzigartigen Haarschmuck zu zaubern.
          </p>
          <p class="text-[var(--color-ink-soft)] leading-relaxed">
            Als gelernte Goldschmiedin sind meine Hauptmaterialien selbstverständlich
            verschiedene Metalle.
          </p>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <Image
          src={portrait}
          alt="Kathrin Kiehl beim Schmieden einer Haarforke in ihrer Werkstatt"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="w-full h-full object-cover aspect-[4/5] md:aspect-auto md:min-h-[520px]"
        />
      </div>
    </section>

    <section class="grid md:grid-cols-2 md:items-stretch mt-6 md:mt-10">
      <div class="order-1">
        <Image
          src={schmieden}
          alt="Titan wird in der Werkstatt geschmiedet"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="w-full h-full object-cover aspect-[4/5] md:aspect-auto md:min-h-[520px]"
        />
      </div>
      <div class="order-2 flex items-center py-12 md:py-20 md:pl-12 lg:pl-16">
        <div class="max-w-md mx-auto text-center md:text-left">
          <p class="eyebrow mb-4">Material</p>
          <h2 class="!text-[clamp(1.75rem,2.8vw,2.4rem)] mb-6">Titan.<br />Ein besonderes Metall.</h2>
          <p class="text-[var(--color-ink-soft)] leading-relaxed mb-4">
            Besonders faszinierend und sinnvoll für Haarschmuck ist für mich Titan.
            Dieser Werkstoff ist extrem leicht, stabil, antiallergen, korrosionsresistent
            und nahezu unverwüstlich – ein echtes Weltraummetall!
          </p>
          <p class="text-[var(--color-ink-soft)] leading-relaxed">
            Das breite Farbspektrum, das dem Titan entlockt werden kann, bringt
            interessante Farbtupfer in jede Frisur.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- MARKTFELDFORSCHUNG — ruhiger Abschluss, zentriert -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow mb-4">Erfahrung</p>
        <h2 class="mb-8">Was Haare lehren.</h2>
        <p class="text-[var(--color-ink-soft)] leading-relaxed text-lg">
          Durch meine langjährige Beschäftigung mit dem Thema Haare und zahlreiche
          haarige Begegnungen auf Messen und Märkten habe ich inzwischen viele Haare
          hochstecken dürfen — lange, kurze, dicke, dünne, lockige, glatte — und ja,
          fast jeder Haarschopf eignet sich dafür!
        </p>
        <p class="mt-4 text-[var(--color-ink-soft)] leading-relaxed text-lg">
          Die Erkenntnisse aus meinen Marktfeldforschungen fließen natürlich in die
          Entwicklung neuer und bestehender Kreationen ein, um Kiehls Klunker noch
          funktionaler zu gestalten.
        </p>
        <p class="mt-12 font-serif text-xl">— Kathrin Kiehl</p>
      </div>
    </div>
  </section>
</BaseLayout>
