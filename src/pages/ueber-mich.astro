---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, t } from '../i18n';
import portrait from '../assets/images/ueber-mich-portrait.jpg';
import schmieden from '../assets/images/titan-schmieden.jpg';

const lang = getLang(Astro);
const a = t(lang).about;
---

<BaseLayout title={a.pageTitle} description={a.pageDescription}>
  <!-- Split 1+2: Editoriales Alternieren, eingefasst im Container (M) -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-20 lg:pt-28">
    <section class="grid md:grid-cols-2 md:items-stretch">
      <div class="order-2 md:order-1 flex items-center py-12 md:py-20 lg:py-28 md:pr-12 lg:pr-16">
        <div class="max-w-md mx-auto text-center md:text-left">
          <p class="eyebrow mb-4">{a.eyebrow}</p>
          <h1 class="!text-[clamp(1.9rem,3.2vw,2.75rem)] mb-6">{a.headline}<br />{a.headlineSince}</h1>
          <p class="text-[var(--color-ink-soft)] leading-relaxed mb-4">
            {a.body1}
          </p>
          <p class="text-[var(--color-ink-soft)] leading-relaxed">
            {a.body2}
          </p>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <Image
          src={portrait}
          alt={a.portraitAlt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="w-full h-full object-cover aspect-[4/5] md:aspect-auto md:min-h-[520px]"
        />
      </div>
    </section>

    <section class="grid md:grid-cols-2 md:items-stretch mt-8 md:mt-12 lg:mt-16">
      <div class="order-1">
        <Image
          src={schmieden}
          alt={a.forgingAlt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="w-full h-full object-cover aspect-[4/5] md:aspect-auto md:min-h-[520px]"
        />
      </div>
      <div class="order-2 flex items-center py-12 md:py-20 lg:py-28 md:pl-12 lg:pl-16">
        <div class="max-w-md mx-auto text-center md:text-left">
          <p class="eyebrow mb-4">{a.materialEyebrow}</p>
          <h2 class="!text-[clamp(1.75rem,2.8vw,2.4rem)] mb-6">{a.materialHeadline}<br />{a.materialSubline}</h2>
          <p class="text-[var(--color-ink-soft)] leading-relaxed mb-4">
            {a.materialBody1}
          </p>
          <p class="text-[var(--color-ink-soft)] leading-relaxed">
            {a.materialBody2}
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- MARKTFELDFORSCHUNG — ruhiger Abschluss, zentriert -->
  <section class="py-12 md:py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow mb-4">{a.experienceEyebrow}</p>
        <h2 class="mb-8">{a.experienceHeadline}</h2>
        <p class="text-[var(--color-ink-soft)] leading-relaxed text-lg">
          {a.experienceBody1}
        </p>
        <p class="mt-4 text-[var(--color-ink-soft)] leading-relaxed text-lg">
          {a.experienceBody2}
        </p>
        <p class="mt-12 font-serif text-xl">{a.signature}</p>
      </div>
    </div>
  </section>
</BaseLayout>
