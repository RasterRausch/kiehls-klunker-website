---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, t, localizedPath } from '../i18n';

const lang = getLang(Astro);
const strings = t(lang);
const d = strings.widerrufDone;
const p = (path: string) => localizedPath(path, lang);
---

<BaseLayout title={d.pageTitle} description={d.pageDescription} noindex={true}>
  <section class="py-12 md:py-20 lg:py-28">
    <div class="max-w-xl mx-auto px-6 md:px-10 text-center">
      <p class="eyebrow mb-4">{d.eyebrow}</p>
      <h1 class="mb-6">{d.title}</h1>
      <p class="text-[var(--color-ink-soft)] leading-relaxed mb-6">
        {d.body}
      </p>
      <p class="text-sm text-[var(--color-ink-mute)] leading-relaxed mb-10">
        {d.next}
      </p>
      <a href={p('/')} class="btn-primary inline-flex">{d.backHome}</a>
    </div>
  </section>
</BaseLayout>
