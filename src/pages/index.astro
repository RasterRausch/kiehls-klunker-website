---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { displayPrice } from '../lib/price';
import { getLang, t, localizedPath } from '../i18n';
import hero from '../assets/images/hero-schmuck.png';
import heroMobile from '../assets/images/hero-mobile.jpg';
import heroSmartphone from '../assets/images/hero-smartphone.jpg';
import soEntsteht from '../assets/images/so-entsteht.jpg';

const lang = getLang(Astro);
const strings = t(lang);
const p = (path: string) => localizedPath(path, lang);
const h = strings.home;

const products = (await getCollection('products'))
  .filter((p) => p.data.available)
  .sort((a, b) => a.data.order - b.data.order);

const sliderProducts = products;

const featuredReviews = (await getCollection('reviews'))
  .filter((r) => r.data.rating === 5 && r.body?.trim())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 60);

// Hero: drei Bilder per <picture>, damit der Browser nur das passende lädt.
// - < 450px:  hero-smartphone (enger Crop)
// - 450–1023: hero-mobile (Querformat)
// - ≥ 1024:   hero-schmuck (Desktop-Background mit Scrim, separat unten)
const heroSmartphoneOpt = await getImage({
  src: heroSmartphone,
  widths: [360, 450, 540, 720],
  format: 'webp',
});
const heroMobileOpt = await getImage({
  src: heroMobile,
  widths: [480, 720, 960, 1280, 1600],
  format: 'webp',
});
---

<BaseLayout title={h.pageTitle}>
  <!-- HERO: Full-bleed, Bild als Hintergrund, Text links auf weißem Bereich -->
  <section class="relative w-full">
    <!-- Desktop: Bild als Hintergrund, Text absolut (ab lg, 1024px+) -->
    <div class="hero-desktop hidden lg:block relative w-full">
      <Image
        src={hero}
        alt={h.heroImageAlt}
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        class="hero-image w-full h-[min(62vh,540px)] lg:h-[min(74vh,680px)] xl:h-[min(82vh,820px)] object-cover"
        loading="eager"
      />
      <!-- Scrim: schützt die Headline vor dem Schmuckstück bei engen Viewports -->
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="absolute inset-0 flex items-center">
        <div class="w-full max-w-7xl mx-auto px-6 md:px-10">
          <div class="max-w-[440px] lg:max-w-[560px] xl:max-w-[620px]">
            <h1 class="hero-headline hero-title mb-6 lg:mb-10">Handmade<br />Jewels.</h1>
            <p class="hero-subtitle font-serif italic text-xl lg:text-2xl xl:text-3xl text-[var(--color-ink-soft)] mb-10 lg:mb-14">
              {h.heroSubtitle}
            </p>
            <p class="hero-body text-sm lg:text-base xl:text-lg text-[var(--color-ink-soft)] mb-10 leading-relaxed max-w-md">
              {h.heroBody}
            </p>
            <div class="flex flex-wrap gap-3">
              <a href={p('/shop')} class="btn-primary">{h.heroCta}</a>
              <a href={p('/ueber-mich')} class="btn-ghost">{h.heroCtaSecondary}</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile + Tablet: Bild oben, Text unten (< lg, < 1024px) -->
    <div class="lg:hidden">
      <picture>
        <!-- Ab 450px: Mobile/Tablet-Querformat -->
        <source
          media="(min-width: 450px)"
          srcset={heroMobileOpt.srcSet.attribute}
          sizes="100vw"
        />
        <!-- Fallback (< 450px): Smartphone-Zuschnitt -->
        <img
          src={heroSmartphoneOpt.src}
          srcset={heroSmartphoneOpt.srcSet.attribute}
          sizes="100vw"
          alt={h.heroImageAlt}
          width="900"
          height="428"
          class="hero-image-mobile w-full aspect-[450/214] object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="px-6 md:px-10 py-12 md:py-20 md:max-w-3xl md:mx-auto text-center">
        <h1 class="hero-headline mb-3">Handmade Jewels.</h1>
        <p class="font-serif italic text-xl text-[var(--color-ink-soft)] mb-8">{h.heroSubtitle}</p>
        <p class="text-base text-[var(--color-ink-soft)] mb-8 leading-relaxed">
          {h.heroBody}
        </p>
        <div class="flex flex-col items-stretch gap-3 max-w-[280px] mx-auto">
          <a href={p('/shop')} class="btn-primary">{h.heroCta}</a>
          <a href={p('/ueber-mich')} class="btn-ghost">{h.heroCtaSecondary}</a>
        </div>
      </div>
    </div>

    <style>
      /* Desktop-Hero: Anker bei 86 % — Scrim liegt links, Gabel soll rechts sichtbar
         bleiben. Mobile: kein Scrim, also zentrieren. */
      .hero-image {
        object-position: 86% center;
      }
      .hero-image-mobile {
        object-position: center center;
      }
      /* Scrim schützt den Textbereich zuverlässig, auch bei schmalem Desktop */
      .hero-scrim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
          to right,
          var(--color-bone) 0%,
          rgba(241, 238, 229, 0.94) 28%,
          rgba(241, 238, 229, 0.6) 44%,
          rgba(241, 238, 229, 0.2) 58%,
          transparent 72%
        );
      }
      @media (min-width: 1280px) {
        .hero-scrim {
          background: linear-gradient(
            to right,
            var(--color-bone) 0%,
            rgba(241, 238, 229, 0.9) 24%,
            rgba(241, 238, 229, 0.5) 40%,
            transparent 60%
          );
        }
      }

      /* Short-Viewport-Optimierung: MacBook 13"/14" mit ~800–900px Höhe.
         Headline ist schon via clamp(..., 13vh, ...) höhenabhängig;
         hier nur noch die vertikalen Abstände straffen. */
      @media (min-width: 1024px) and (max-height: 860px) {
        .hero-desktop .hero-title {
          margin-bottom: 1.25rem;
        }
        .hero-desktop .hero-subtitle {
          margin-bottom: 1.75rem;
          font-size: 1.375rem; /* text-xl */
        }
        .hero-desktop .hero-body {
          margin-bottom: 1.75rem;
          font-size: 0.9375rem;
        }
      }
      @media (min-width: 1024px) and (max-height: 760px) {
        .hero-desktop .hero-title {
          margin-bottom: 1rem;
        }
        .hero-desktop .hero-subtitle {
          margin-bottom: 1.25rem;
        }
        .hero-desktop .hero-body {
          margin-bottom: 1.5rem;
        }
      }
    </style>
  </section>

  <!-- BRAND-PHILOSOPHY (S — kurzer, ruhiger Moment) -->
  <section class="py-8 md:py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow mb-6">{h.philosophyEyebrow}</p>
        <blockquote class="font-serif text-3xl md:text-4xl leading-[1.3] text-[var(--color-ink)]">
          {h.philosophyQuote}
        </blockquote>
        <p class="mt-8 text-sm text-[var(--color-ink-soft)]">{h.philosophyAuthor}</p>
      </div>
    </div>
  </section>

  <!-- KOLLEKTION: Full-bleed Slider (M) -->
  <section class="pt-0 pb-12 md:pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-6 md:px-10 flex flex-col md:flex-row md:items-end md:justify-between gap-5 md:gap-0 mb-8 md:mb-12 text-center md:text-left">
      <div>
        <p class="eyebrow mb-3">{h.collectionEyebrow}</p>
        <h2>{h.collectionHeadline}</h2>
      </div>
      <a href={p('/shop')} class="link-arrow whitespace-nowrap self-center md:self-auto">{h.collectionCta} <span class="arrow">→</span></a>
    </div>

    <!-- Slider wrapper (relative für Arrow-Button) -->
    <div class="product-slider-wrapper relative group">
      <div
        id="product-slider"
        class="product-slider overflow-x-auto scrollbar-hide"
        role="region"
        aria-roledescription={strings.home.sliderRoleDescription}
        aria-label={strings.home.collectionHeadline}
        tabindex="0"
      >
        <div class="flex gap-6 md:gap-8 container-align pb-2">
          {sliderProducts.map((product, i) => (
            <a
              href={p(`/shop/${product.id}`)}
              class="product-card group/card block shrink-0"
              style="width: clamp(260px, 26vw, 440px);"
              data-idx={i}
            >
              <div class="relative aspect-square overflow-hidden bg-[var(--color-bone)] mb-6">
                <Image
                  src={product.data.images[0]}
                  alt=""
                  draggable={false}
                  widths={[300, 480, 640, 900]}
                  sizes="clamp(260px, 26vw, 440px)"
                  class="w-full h-full object-cover group-hover/card:scale-[1.04] transition-transform duration-700"
                />
                <!-- Hover Overlay -->
                <div class="quick-add">
                  <span class="quick-add-label">{h.cardHoverLabel}</span>
                </div>
              </div>
              <h3 class="font-sans text-base md:text-lg font-medium leading-snug mb-1 text-[var(--color-ink)]">{lang === 'en' && product.data.nameEn ? product.data.nameEn : product.data.name}</h3>
              <p class="text-sm text-[var(--color-ink-soft)] mb-3">{lang === 'en' && product.data.taglineEn ? product.data.taglineEn : product.data.tagline}</p>
              <p class="text-sm">
                {displayPrice(product.data).toFixed(2).replace('.', ',')} €
              </p>
            </a>
          ))}
        </div>
      </div>

      <!-- Right Arrow Button -->
      <button
        type="button"
        aria-label={h.sliderNextProducts}
        class="slider-nav slider-nav-right"
        data-slider-next
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round"/>
          <polyline points="13 6 19 12 13 18" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        aria-label={h.sliderPrevProducts}
        class="slider-nav slider-nav-left"
        data-slider-prev
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="19" y1="12" x2="5" y2="12" stroke-linecap="round"/>
          <polyline points="11 6 5 12 11 18" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </section>

  <script>
    import { initHorizontalSlider } from '../scripts/horizontal-slider';
    initHorizontalSlider({
      sliderId: 'product-slider',
      prevSelector: '[data-slider-prev]',
      nextSelector: '[data-slider-next]',
      cardSelector: '.product-card',
    });
  </script>

  <hr class="hairline" />

  <!-- REVIEWS — Slider mit Drag + Arrows (M) -->
  {featuredReviews.length > 0 && (
    <section class="py-12 md:py-20 lg:py-28">
      <div class="max-w-7xl mx-auto px-6 md:px-10 text-center mb-12 md:mb-16">
        <p class="eyebrow mb-3">{h.reviewsEyebrow}</p>
        <h2>{h.reviewsHeadline}</h2>
        <p class="mt-4 text-sm text-[var(--color-ink-mute)]">
          {h.reviewsSub}
        </p>
      </div>

      <div class="product-slider-wrapper relative group">
        <div
          id="review-slider"
          class="product-slider overflow-x-auto scrollbar-hide"
          role="region"
          aria-roledescription={strings.home.sliderRoleDescription}
          aria-label={strings.home.reviewsHeadline}
          tabindex="0"
        >
          <div class="flex gap-6 md:gap-8 container-align pb-2 items-stretch">
            {featuredReviews.map((review, idx) => (
              <div
                class="shrink-0 w-[clamp(280px,28vw,400px)]"
                style="width: clamp(280px, 28vw, 400px);"
              >
                <ReviewCard
                  id={`r${idx}`}
                  author={review.data.author}
                  rating={review.data.rating}
                  date={review.data.date}
                  productName={review.data.productName}
                  body={review.body?.trim() || ''}
                  verified={review.data.verified}
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Arrow Buttons -->
        <button
          type="button"
          aria-label={h.sliderNextReviews}
          class="slider-nav slider-nav-right"
          data-review-next
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round"/>
            <polyline points="13 6 19 12 13 18" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          aria-label={h.sliderPrevReviews}
          class="slider-nav slider-nav-left"
          data-review-prev
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="19" y1="12" x2="5" y2="12" stroke-linecap="round"/>
            <polyline points="11 6 5 12 11 18" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </section>
  )}

  <script>
    import { initHorizontalSlider } from '../scripts/horizontal-slider';
    initHorizontalSlider({
      sliderId: 'review-slider',
      prevSelector: '[data-review-prev]',
      nextSelector: '[data-review-next]',
      cardSelector: '.snap-start',
    });
  </script>

  <!-- USP / Trust-Badges (S — supportive) -->
  <section class="py-8 md:py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-10 md:gap-12">
      <div class="text-center md:text-left">
        <svg class="block mx-auto md:mx-0 mb-6 text-[var(--color-ink-soft)]" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l8 3v6c0 4.5-3.2 8.3-8 9-4.8-0.7-8-4.5-8-9V6l8-3z" />
        </svg>
        <h3 class="font-serif text-2xl md:text-[1.7rem] mb-3">{h.uspPaymentsHeadline}</h3>
        <p class="text-[var(--color-ink-soft)] leading-relaxed">
          {h.uspPaymentsBody}
        </p>
      </div>
      <div class="text-center md:text-left">
        <svg class="block mx-auto md:mx-0 mb-6 text-[var(--color-ink-soft)]" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1.5" y="7" width="12" height="9" />
          <path d="M13.5 10h4l3 3v3h-7" />
          <circle cx="6" cy="18" r="1.7" />
          <circle cx="17" cy="18" r="1.7" />
        </svg>
        <h3 class="font-serif text-2xl md:text-[1.7rem] mb-3">{h.uspShippingHeadline}</h3>
        <p class="text-[var(--color-ink-soft)] leading-relaxed">
          {h.uspShippingBody}
        </p>
      </div>
      <div class="text-center md:text-left">
        <svg class="block mx-auto md:mx-0 mb-6 text-[var(--color-ink-soft)]" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M8.5 14c0.9 1.3 2.1 2 3.5 2s2.6-0.7 3.5-2" />
          <circle cx="9" cy="10" r="0.6" fill="currentColor" />
          <circle cx="15" cy="10" r="0.6" fill="currentColor" />
        </svg>
        <h3 class="font-serif text-2xl md:text-[1.7rem] mb-3">{h.uspCustomersHeadline}</h3>
        <p class="text-[var(--color-ink-soft)] leading-relaxed">
          {h.uspCustomersBody}
        </p>
      </div>
    </div>
  </section>

  <!-- MAKING-OF (M) -->
  <section class="bg-[var(--color-bone)]">
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-12 md:py-20 lg:py-28 grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <div class="order-2 md:order-1">
        <Image src={soEntsteht} alt={h.craftImageAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="w-full h-auto" />
      </div>
      <div class="order-1 md:order-2 text-center md:text-left">
        <p class="eyebrow mb-4">{h.craftEyebrow}</p>
        <h2 class="mb-6">{h.craftHeadline}</h2>
        <p class="text-[var(--color-ink-soft)] leading-relaxed mb-4">
          {h.craftBody1}
        </p>
        <p class="text-[var(--color-ink-soft)] leading-relaxed mb-8">
          {h.craftBody2}
        </p>
        <a href={p('/ueber-mich')} class="link-arrow">{h.craftCta} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>
