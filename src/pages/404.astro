---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, t, localizedPath } from '../i18n';

const lang = getLang(Astro);
const strings = t(lang);
const p = (path: string) => localizedPath(path, lang);
const n = strings.notFound;

// Im SSR-Modus den HTTP-Status korrekt auf 404 setzen, damit Crawler nicht
// denken, die Seite sei ein echter Inhalt.
Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout title={n.pageTitle} description={n.pageDescription} noindex={true}>
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-12 md:py-20 lg:py-28">
    <div class="max-w-2xl mx-auto text-center">
      <p class="eyebrow mb-6">{n.eyebrow}</p>
      <h1 class="mb-8 not-found-headline">{n.headline}</h1>
      <p class="text-[var(--color-ink-soft)] leading-relaxed mb-12 md:mb-16">
        {n.body}
      </p>

      <nav class="flex flex-col items-center gap-3 max-w-[320px] mx-auto">
        <a href={p('/')} class="btn-primary w-full">{n.linkHome}</a>
        <a href={p('/shop')} class="btn-ghost w-full">{n.linkShop}</a>
        <a href={p('/einzelstuecke')} class="link-arrow mt-4">
          {n.linkEinzelstuecke} <span class="arrow">→</span>
        </a>
        <a href={p('/kontakt')} class="link-arrow">
          {n.linkContact} <span class="arrow">→</span>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  /* Große 404-Headline — dezent, ohne den Besucher zu erschlagen. */
  .not-found-headline {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
</style>
