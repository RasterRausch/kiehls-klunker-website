---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalEnNotice from '../components/LegalEnNotice.astro';
---

<BaseLayout title="Widerrufsbelehrung — Kiehls Klunker" description="Widerrufsbelehrung für Verbraucher.">
  <LegalEnNotice />
  <section class="max-w-3xl mx-auto px-6 md:px-10 py-20 md:py-28">
    <p class="eyebrow mb-4">Rechtliches</p>
    <h1 class="mb-10">Widerrufsbelehrung</h1>

    <div class="text-[var(--color-ink-soft)] leading-relaxed space-y-4">
      <p class="bg-[var(--color-bone-deep)] px-4 py-3 text-sm text-[var(--color-ink)]">
        Platzhalter — die Widerrufsbelehrung wird hier eingefügt, sobald die finale Fassung vorliegt.
      </p>
    </div>
  </section>
</BaseLayout>
