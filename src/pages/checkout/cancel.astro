---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Bestellung abgebrochen — Kiehls Klunker" description="Dein Warenkorb ist erhalten geblieben.">
  <section class="max-w-2xl mx-auto px-6 md:px-10 py-24 md:py-32 text-center">
    <p class="eyebrow mb-6">Bezahlung abgebrochen</p>
    <h1 class="mb-6">Kein Problem — dein Warenkorb ist erhalten.</h1>
    <p class="text-[var(--color-ink-soft)] leading-relaxed mb-12">
      Du kannst deine Auswahl jederzeit wieder öffnen und die Bestellung in Ruhe abschließen.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/shop" class="btn-primary">Zurück zum Shop</a>
      <button type="button" class="btn-ghost" data-cart-open>Warenkorb öffnen</button>
    </div>
  </section>
</BaseLayout>
