---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLang, t, localizedPath } from '../../i18n';

const lang = getLang(Astro);
const strings = t(lang);
const p = (path: string) => localizedPath(path, lang);
const s = strings.checkout.success;
const pageTitle = lang === 'en' ? 'Order confirmed — Kiehls Klunker' : 'Bestellung bestätigt — Kiehls Klunker';
const pageDesc = lang === 'en' ? 'Thank you for your order.' : 'Danke für deine Bestellung.';
const eyebrow = lang === 'en' ? 'Order confirmed' : 'Bestellung bestätigt';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="max-w-2xl mx-auto px-6 md:px-10 py-12 md:py-20 lg:py-28 text-center">
    <p class="eyebrow mb-6">{eyebrow}</p>
    <h1 class="mb-6">{s.title}</h1>
    <p class="text-[var(--color-ink-soft)] leading-relaxed mb-4">
      {s.thanks}
    </p>
    <p class="text-[var(--color-ink-soft)] leading-relaxed mb-12">
      {s.shipping}
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href={p('/shop')} class="btn-primary">{s.keepShopping}</a>
      <a href={p('/')} class="btn-ghost">{s.home}</a>
    </div>
  </section>

  <script is:inline>
    // Warenkorb leeren, Header-Badge aktualisieren
    localStorage.removeItem('cart');
    window.dispatchEvent(new CustomEvent('cart:changed'));
  </script>
</BaseLayout>
