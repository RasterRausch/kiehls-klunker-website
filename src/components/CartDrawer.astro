---
// Cart Drawer — wird in BaseLayout global eingebunden.
// Steuerung:
//   - Öffnen: dispatchEvent(new CustomEvent('cart:open'))  ODER click auf [data-cart-open]
//   - Schließen: click auf [data-cart-close] / Overlay / Escape
//   - Item-Änderung: `cart:changed`-Event triggert Re-Render + Badge-Update
---

<!-- Overlay -->
<div
  id="cart-overlay"
  class="fixed inset-0 bg-[var(--color-ink)]/35 z-[90] opacity-0 pointer-events-none transition-opacity duration-300"
  data-cart-close
  aria-hidden="true"
></div>

<!-- Drawer -->
<aside
  id="cart-drawer"
  class="fixed top-0 right-0 bottom-0 w-full sm:w-[440px] bg-[var(--color-paper)] z-[100] flex flex-col shadow-[-10px_0_40px_rgba(28,28,26,0.08)]"
  aria-labelledby="cart-drawer-title"
  aria-hidden="true"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-[var(--color-hairline)]">
    <p id="cart-drawer-title" class="eyebrow !text-[var(--color-ink)]">Warenkorb</p>
    <button
      type="button"
      data-cart-close
      aria-label="Warenkorb schließen"
      class="icon-btn"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19" stroke-linecap="round"/>
        <line x1="19" y1="5" x2="5" y2="19" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Items -->
  <div id="cart-drawer-items" class="flex-1 overflow-y-auto">
    <!-- Leer-Zustand -->
    <div id="cart-drawer-empty" class="hidden px-6 py-16 text-center">
      <p class="text-[var(--color-ink-soft)] leading-relaxed mb-6">Dein Warenkorb ist noch leer.</p>
      <a href="/shop" class="btn-primary" data-cart-close>Zum Shop</a>
    </div>
    <!-- Item-Liste -->
    <ul id="cart-drawer-list" class="divide-y divide-[var(--color-hairline)]"></ul>
  </div>

  <!-- Footer (nur wenn gefüllt) -->
  <div id="cart-drawer-footer" class="hidden border-t border-[var(--color-hairline)] px-6 py-5">
    <div class="flex items-end justify-between mb-2">
      <span class="text-sm text-[var(--color-ink-soft)]">Zwischensumme</span>
      <span class="font-serif text-2xl" id="cart-drawer-total">0,00 €</span>
    </div>
    <p class="text-xs text-[var(--color-ink-mute)] mb-4">Versand wird an der Kasse berechnet.</p>

    <label class="flex gap-2.5 mb-4 cursor-pointer select-none" for="cart-agb-check">
      <input
        type="checkbox"
        id="cart-agb-check"
        class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-ink)] cursor-pointer"
      />
      <span class="text-xs leading-relaxed text-[var(--color-ink-soft)]">
        Ich habe die <a href="/agb" target="_blank" class="underline underline-offset-2 hover:text-[var(--color-ink)]">AGB</a>,
        <a href="/widerruf" target="_blank" class="underline underline-offset-2 hover:text-[var(--color-ink)]">Widerrufsbelehrung</a> und
        <a href="/datenschutz" target="_blank" class="underline underline-offset-2 hover:text-[var(--color-ink)]">Datenschutzhinweise</a>
        gelesen und stimme ihnen zu.
      </span>
    </label>

    <p id="cart-drawer-error" class="hidden text-xs text-[var(--color-ink)] bg-[var(--color-bone-deep)] px-3 py-2 mb-3"></p>
    <button
      type="button"
      id="cart-drawer-checkout"
      disabled
      class="btn-primary w-full disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span data-checkout-label>Zur Kasse</span>
      <span data-checkout-loading class="hidden">Bitte warten…</span>
    </button>
  </div>
</aside>

<template id="cart-drawer-item-template">
  <li class="px-6 py-5 flex gap-4" data-item>
    <a class="block shrink-0 w-20 h-20 bg-[var(--color-bone)] overflow-hidden" data-item-link>
      <img class="w-full h-full object-cover" data-item-image alt="" />
    </a>
    <div class="flex-1 min-w-0 flex flex-col">
      <a data-item-link class="block">
        <p class="font-serif text-base leading-snug line-clamp-2 text-[var(--color-ink)]" data-item-name></p>
      </a>
      <p class="text-[0.7rem] text-[var(--color-ink-soft)] mt-1 hidden" data-item-variants></p>
      <p class="text-xs text-[var(--color-ink-soft)] mt-1" data-item-price></p>

      <div class="mt-auto pt-3 flex items-end justify-between gap-3">
        <div class="flex items-center border border-[var(--color-hairline)]">
          <button type="button" class="qty-btn" data-qty-decrease aria-label="Menge verringern">−</button>
          <span class="min-w-[2rem] text-center text-sm" data-item-qty></span>
          <button type="button" class="qty-btn" data-qty-increase aria-label="Menge erhöhen">+</button>
        </div>
        <button type="button" class="text-[0.65rem] uppercase tracking-[0.18em] text-[var(--color-ink-mute)] hover:text-[var(--color-ink)] transition-colors" data-remove>
          Entfernen
        </button>
      </div>
    </div>
  </li>
</template>

<style is:global>
  #cart-drawer {
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  #cart-drawer[data-open="true"] { transform: translateX(0); }
  #cart-overlay[data-open="true"] { opacity: 1; pointer-events: auto; }
  body[data-cart-open="true"] { overflow: hidden; }
  .qty-btn {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .qty-btn:hover { background: var(--color-bone-deep); }
</style>

<script is:inline>
  (() => {
    const drawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-overlay');
    const list = document.getElementById('cart-drawer-list');
    const emptyEl = document.getElementById('cart-drawer-empty');
    const footer = document.getElementById('cart-drawer-footer');
    const totalEl = document.getElementById('cart-drawer-total');
    const template = document.getElementById('cart-drawer-item-template');
    if (!drawer) return;

    const fmt = (n) => n.toFixed(2).replace('.', ',') + ' €';
    const load = () => JSON.parse(localStorage.getItem('cart') || '[]');
    const save = (cart) => {
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart:changed'));
    };

    const keyOf = (item) => item.cartKey || item.id;
    const formatVariants = (v) => {
      if (!v || typeof v !== 'object') return '';
      return Object.keys(v).map((k) => `${k}: ${v[k]}`).join(' · ');
    };

    const render = () => {
      const cart = load();
      list.innerHTML = '';
      if (cart.length === 0) {
        emptyEl.classList.remove('hidden');
        footer.classList.add('hidden');
      } else {
        emptyEl.classList.add('hidden');
        footer.classList.remove('hidden');
        let total = 0;
        for (const item of cart) {
          total += item.price * item.quantity;
          const node = template.content.cloneNode(true);
          const root = node.querySelector('[data-item]');
          root.dataset.itemKey = keyOf(item);
          node.querySelectorAll('[data-item-link]').forEach((a) => (a.href = '/shop/' + item.id));
          const img = node.querySelector('[data-item-image]');
          if (item.image) img.src = item.image;
          img.alt = item.name;
          node.querySelector('[data-item-name]').textContent = item.name;
          const variantsEl = node.querySelector('[data-item-variants]');
          const variantStr = formatVariants(item.variants);
          if (variantStr) {
            variantsEl.textContent = variantStr;
            variantsEl.classList.remove('hidden');
          }
          node.querySelector('[data-item-price]').textContent = fmt(item.price) + ' je Stück';
          node.querySelector('[data-item-qty]').textContent = item.quantity;
          list.appendChild(node);
        }
        totalEl.textContent = fmt(total);
      }
    };

    const open = () => {
      render();
      drawer.dataset.open = 'true';
      overlay.dataset.open = 'true';
      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.dataset.cartOpen = 'true';
    };
    const close = () => {
      drawer.dataset.open = 'false';
      overlay.dataset.open = 'false';
      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.dataset.cartOpen = 'false';
    };

    // Events
    window.addEventListener('cart:open', open);
    window.addEventListener('cart:close', close);
    window.addEventListener('cart:changed', () => { if (drawer.dataset.open === 'true') render(); });
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.dataset.open === 'true') close(); });

    // Open-Trigger (Header-Cart-Icon etc.)
    document.querySelectorAll('[data-cart-open]').forEach((btn) => {
      btn.addEventListener('click', (e) => { e.preventDefault(); open(); });
    });

    // Close-Trigger (X-Button, Overlay, Leer-Zustand-Link)
    document.querySelectorAll('[data-cart-close]').forEach((el) => {
      el.addEventListener('click', (e) => {
        // Wenn der Close-Trigger ein echter Link ist (z. B. Zum Shop), zuerst schließen, dann natürlich weiterleiten
        if (el.tagName !== 'A') e.preventDefault();
        close();
      });
    });

    // Quantity / Remove in drawer
    list.addEventListener('click', (e) => {
      const item = e.target.closest('[data-item]');
      if (!item) return;
      const key = item.dataset.itemKey;
      const cart = load();
      const idx = cart.findIndex((c) => (c.cartKey || c.id) === key);
      if (idx < 0) return;
      if (e.target.closest('[data-qty-increase]')) cart[idx].quantity += 1;
      else if (e.target.closest('[data-qty-decrease]')) {
        cart[idx].quantity -= 1;
        if (cart[idx].quantity <= 0) cart.splice(idx, 1);
      } else if (e.target.closest('[data-remove]')) cart.splice(idx, 1);
      else return;
      save(cart);
      render();
    });

    // Cross-tab sync
    window.addEventListener('storage', (e) => { if (e.key === 'cart') render(); });

    // Checkout
    const checkoutBtn = document.getElementById('cart-drawer-checkout');
    const errorEl = document.getElementById('cart-drawer-error');
    const agbCheck = document.getElementById('cart-agb-check');
    const labelEl = checkoutBtn?.querySelector('[data-checkout-label]');
    const loadingEl = checkoutBtn?.querySelector('[data-checkout-loading]');

    const syncCheckoutEnabled = () => {
      if (!checkoutBtn || !agbCheck) return;
      checkoutBtn.disabled = !agbCheck.checked;
    };
    agbCheck?.addEventListener('change', syncCheckoutEnabled);
    syncCheckoutEnabled();

    const setCheckoutLoading = (loading) => {
      if (!checkoutBtn) return;
      checkoutBtn.disabled = loading || !agbCheck?.checked;
      labelEl?.classList.toggle('hidden', loading);
      loadingEl?.classList.toggle('hidden', !loading);
    };
    const showError = (msg) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };
    const hideError = () => errorEl?.classList.add('hidden');

    checkoutBtn?.addEventListener('click', async () => {
      const cart = load();
      if (cart.length === 0) return;
      hideError();
      setCheckoutLoading(true);
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: cart.map((i) => ({
              id: i.id,
              quantity: i.quantity,
              variants: i.variants || {},
            })),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.url) {
          throw new Error(data.error || 'Checkout konnte nicht erstellt werden.');
        }
        window.location.href = data.url;
      } catch (err) {
        showError(err instanceof Error ? err.message : 'Unbekannter Fehler.');
        setCheckoutLoading(false);
      }
    });
  })();
</script>
