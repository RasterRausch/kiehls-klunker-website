---
// Cart Drawer — wird in BaseLayout global eingebunden.
// Steuerung:
//   - Öffnen: dispatchEvent(new CustomEvent('cart:open'))  ODER click auf [data-cart-open]
//   - Schließen: click auf [data-cart-close] / Overlay / Escape
//   - Item-Änderung: `cart:changed`-Event triggert Re-Render + Badge-Update

import { getLang, t, localizedPath, VARIANT_NAME_MAP, COLOR_VALUE_MAP } from '../i18n';
import { STD_RATE_EUR, US_RATE_EUR } from '../lib/shipping';

const lang = getLang(Astro);
const strings = t(lang);
const p = (path: string) => localizedPath(path, lang);
const testMode = import.meta.env.PUBLIC_TEST_MODE === 'true';
---

<!-- Overlay -->
<div
  id="cart-overlay"
  class="fixed inset-0 bg-[var(--color-ink)]/35 z-[90] opacity-0 pointer-events-none transition-opacity duration-300"
  data-cart-close
  aria-hidden="true"
></div>

<!-- Drawer -->
<aside
  id="cart-drawer"
  class="fixed top-0 right-0 bottom-0 w-full sm:w-[440px] bg-[var(--color-paper)] z-[100] flex flex-col shadow-[-10px_0_40px_rgba(28,28,26,0.08)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title"
  aria-hidden="true"
>
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-[var(--color-hairline)]">
    <p id="cart-drawer-title" class="eyebrow !text-[var(--color-ink)]">{strings.cart.title}</p>
    <button
      type="button"
      data-cart-close
      aria-label={strings.cart.close}
      class="icon-btn"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19" stroke-linecap="round"/>
        <line x1="19" y1="5" x2="5" y2="19" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Items -->
  <div id="cart-drawer-items" class="flex-1 overflow-y-auto">
    <!-- Leer-Zustand -->
    <div id="cart-drawer-empty" class="hidden px-6 py-16 text-center">
      <p class="text-[var(--color-ink-soft)] leading-relaxed mb-6">{strings.cart.empty}</p>
      <a href={p('/shop')} class="btn-primary" data-cart-close>{strings.cart.toShop}</a>
    </div>
    <!-- Item-Liste -->
    <ul id="cart-drawer-list" class="divide-y divide-[var(--color-hairline)]"></ul>
  </div>

  <!-- Footer (nur wenn gefüllt) -->
  <div id="cart-drawer-footer" class="hidden border-t border-[var(--color-hairline)] px-6 py-5">
    <!-- Versand-Tier-Auswahl -->
    <fieldset class="mb-4">
      <legend class="text-xs uppercase tracking-[0.16em] text-[var(--color-ink-mute)] mb-2">{strings.cart.shippingTo}</legend>
      <div class="flex flex-col gap-1.5" role="radiogroup">
        <label class="flex items-center gap-2.5 cursor-pointer text-sm">
          <input type="radio" name="cart-shipping-tier" value="STD" class="accent-[var(--color-ink)]" checked />
          <span class="flex-1">{strings.cart.tierSTD}</span>
          <span class="text-xs text-[var(--color-ink-mute)]" data-tier-cost="STD">—</span>
        </label>
        <label class="flex items-center gap-2.5 cursor-pointer text-sm">
          <input type="radio" name="cart-shipping-tier" value="US" class="accent-[var(--color-ink)]" />
          <span class="flex-1">{strings.cart.tierUS}</span>
          <span class="text-xs text-[var(--color-ink-mute)]" data-tier-cost="US">—</span>
        </label>
      </div>
    </fieldset>

    <div class="flex items-baseline justify-between mb-1 text-sm text-[var(--color-ink-soft)]">
      <span>{strings.cart.subtotal}</span>
      <span data-cart-subtotal>0,00 €</span>
    </div>
    <div class="flex items-baseline justify-between mb-3 text-sm text-[var(--color-ink-soft)]">
      <span>{strings.cart.shipping}</span>
      <span data-cart-shipping>0,00 €</span>
    </div>
    <div class="flex items-end justify-between mb-2">
      <span class="text-sm text-[var(--color-ink-soft)]">{strings.cart.total}</span>
      <span class="font-serif text-2xl" id="cart-drawer-total">0,00 €</span>
    </div>

    {testMode ? (
      <p class="text-xs leading-relaxed text-[var(--color-ink)] bg-[var(--color-bone-deep)] px-4 py-3 text-center">
        {strings.testMode.cartNotice}
      </p>
    ) : (
      <>
        <label class="flex gap-2.5 mb-4 cursor-pointer select-none" for="cart-agb-check">
          <input
            type="checkbox"
            id="cart-agb-check"
            class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-ink)] cursor-pointer"
          />
          <span class="text-xs leading-relaxed text-[var(--color-ink-soft)]">
            {strings.cart.termsIntro} <a href="/agb" target="_blank" class="underline underline-offset-2 hover:text-[var(--color-ink)]">{strings.footer.agb}</a>{strings.cart.termsAnd}
            <a href="/widerruf" target="_blank" class="underline underline-offset-2 hover:text-[var(--color-ink)]">{strings.footer.widerruf}</a> {strings.cart.termsMid}
            <a href="/datenschutz" target="_blank" class="underline underline-offset-2 hover:text-[var(--color-ink)]">{strings.footer.datenschutz}</a>{strings.cart.termsOutro}
          </span>
        </label>

        <p id="cart-drawer-error" role="alert" aria-live="assertive" class="hidden text-xs text-[var(--color-ink)] bg-[var(--color-bone-deep)] px-3 py-2 mb-3"></p>
        <button
          type="button"
          id="cart-drawer-checkout"
          disabled
          class="btn-primary w-full disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span data-checkout-label>{strings.cart.checkout}</span>
          <span data-checkout-loading class="hidden">{strings.cart.checkoutLoading}</span>
        </button>
      </>
    )}
  </div>
</aside>

<template id="cart-drawer-item-template">
  <li class="px-6 py-5 flex gap-4" data-item>
    <a class="block shrink-0 w-20 h-20 bg-[var(--color-bone)] overflow-hidden" data-item-link>
      <img class="w-full h-full object-cover" data-item-image alt="" />
    </a>
    <div class="flex-1 min-w-0 flex flex-col">
      <a data-item-link class="block">
        <p class="font-sans text-sm font-medium leading-snug line-clamp-2 text-[var(--color-ink)]" data-item-name></p>
      </a>
      <p class="text-[0.7rem] text-[var(--color-ink-soft)] mt-1 hidden" data-item-variants></p>
      <p class="text-[0.7rem] text-[var(--color-ink-soft)] italic mt-1 hidden line-clamp-2" data-item-personalization></p>
      <p class="text-xs text-[var(--color-ink-soft)] mt-1" data-item-price></p>

      <div class="mt-auto pt-3 flex items-end justify-between gap-3">
        <div class="flex items-center border border-[var(--color-hairline)]">
          <button type="button" class="qty-btn" data-qty-decrease aria-label={strings.product.decreaseQty}>−</button>
          <span class="min-w-[2rem] text-center text-sm" data-item-qty></span>
          <button type="button" class="qty-btn" data-qty-increase aria-label={strings.product.increaseQty}>+</button>
        </div>
        <button type="button" class="text-[0.65rem] uppercase tracking-[0.18em] text-[var(--color-ink-mute)] hover:text-[var(--color-ink)] transition-colors" data-remove>
          {strings.cart.remove}
        </button>
      </div>
    </div>
  </li>
</template>

<style is:global>
  #cart-drawer {
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  #cart-drawer[data-open="true"] { transform: translateX(0); }
  #cart-overlay[data-open="true"] { opacity: 1; pointer-events: auto; }
  body[data-cart-open="true"] { overflow: hidden; }
  .qty-btn {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    color: var(--color-ink);
    cursor: pointer;
  }
</style>

<script is:inline define:vars={{
  lang,
  perItemLabel: strings.cart.perItem,
  wishTemplate: strings.cart.wish,
  checkoutErrorGeneric: strings.cart.checkoutError,
  checkoutLabel: strings.cart.checkout,
  checkoutLoading: strings.cart.checkoutLoading,
  stdRate: STD_RATE_EUR,
  usRate: US_RATE_EUR,
  variantNameMap: VARIANT_NAME_MAP,
  colorValueMap: COLOR_VALUE_MAP,
}}>
  (() => {
    // Cart-Schema-Version: bei Schema-Änderungen erhöhen, dann werden alte
    // localStorage-Carts beim ersten Page-Load gedroppt.
    const CART_VERSION = '3';
    if (localStorage.getItem('kk_cart_version') !== CART_VERSION) {
      localStorage.removeItem('cart');
      localStorage.removeItem('kk_shipping_tier');
      localStorage.setItem('kk_cart_version', CART_VERSION);
    }

    const drawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-overlay');
    const list = document.getElementById('cart-drawer-list');
    const emptyEl = document.getElementById('cart-drawer-empty');
    const footer = document.getElementById('cart-drawer-footer');
    const totalEl = document.getElementById('cart-drawer-total');
    const template = document.getElementById('cart-drawer-item-template');
    if (!drawer) return;

    // Preise locale-gerecht formatieren (DE: 39,00 €, EN: €39.00)
    const fmt = (n) => lang === 'en'
      ? '€' + n.toFixed(2)
      : n.toFixed(2).replace('.', ',') + ' €';
    const load = () => JSON.parse(localStorage.getItem('cart') || '[]');
    const save = (cart) => {
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent('cart:changed'));
    };

    const keyOf = (item) => item.cartKey || item.id;

    // Variant-Translation-Maps kommen via define:vars aus src/i18n/index.ts —
    // Single-Source-of-Truth, keine Drift mehr zwischen Server und Client.
    const tName = (n) => lang === 'de' ? n : (variantNameMap[n] || n);
    const tValue = (v) => {
      if (lang === 'de') return v;
      const m = v.match(/^(\d+\s+)(.+)$/);
      if (m) {
        const key = m[2].toLowerCase();
        return colorValueMap[key] ? `${m[1]}${colorValueMap[key]}` : v;
      }
      return colorValueMap[v.toLowerCase()] || v;
    };

    const formatVariants = (v) => {
      if (!v || typeof v !== 'object') return '';
      return Object.keys(v).map((k) => `${tName(k)}: ${tValue(v[k])}`).join(' · ');
    };

    // Versand-Tier: gemerkt in localStorage, Default = STD
    const TIER_KEY = 'kk_shipping_tier';
    const loadTier = () => {
      const v = localStorage.getItem(TIER_KEY);
      return v === 'US' ? 'US' : 'STD';
    };
    const saveTier = (t) => localStorage.setItem(TIER_KEY, t);

    // Versandkosten-Logik — Spiegel von src/lib/shipping.ts:
    // Beide Tiers sind Pauschalen pro Bestellung, unabhängig von Menge.
    const computeTotals = (cart, tier) => {
      let subtotal = 0;
      for (const i of cart) subtotal += i.price * i.quantity;

      const shipping = cart.length > 0
        ? (tier === 'US' ? usRate : stdRate)
        : 0;
      return { subtotal, shipping, total: subtotal + shipping };
    };

    const subtotalEl = footer?.querySelector('[data-cart-subtotal]');
    const shippingEl = footer?.querySelector('[data-cart-shipping]');
    const tierCostEls = footer ? footer.querySelectorAll('[data-tier-cost]') : [];
    const tierRadios = footer ? footer.querySelectorAll('input[name="cart-shipping-tier"]') : [];

    const render = () => {
      const cart = load();
      list.innerHTML = '';
      if (cart.length === 0) {
        emptyEl.classList.remove('hidden');
        footer.classList.add('hidden');
      } else {
        emptyEl.classList.add('hidden');
        footer.classList.remove('hidden');
        for (const item of cart) {
          const node = template.content.cloneNode(true);
          const root = node.querySelector('[data-item]');
          root.dataset.itemKey = keyOf(item);
          const shopPathPrefix = lang === 'en' ? '/en/shop/' : '/shop/';
          node.querySelectorAll('[data-item-link]').forEach((a) => (a.href = shopPathPrefix + item.id));
          const img = node.querySelector('[data-item-image]');
          if (item.image) img.src = item.image;
          img.alt = item.name;
          node.querySelector('[data-item-name]').textContent = item.name;
          const variantsEl = node.querySelector('[data-item-variants]');
          const variantStr = formatVariants(item.variants);
          if (variantStr) {
            variantsEl.textContent = variantStr;
            variantsEl.classList.remove('hidden');
          }
          const personalizationEl = node.querySelector('[data-item-personalization]');
          if (item.personalization) {
            personalizationEl.textContent = wishTemplate.replace('{text}', item.personalization);
            personalizationEl.classList.remove('hidden');
          }
          node.querySelector('[data-item-price]').textContent = fmt(item.price) + ' ' + perItemLabel;
          node.querySelector('[data-item-qty]').textContent = item.quantity;
          list.appendChild(node);
        }

        // Tier wiederherstellen + Totals rendern
        const tier = loadTier();
        tierRadios.forEach((r) => { r.checked = r.value === tier; });
        renderTotals(cart, tier);
      }
    };

    const renderTotals = (cart, tier) => {
      const { subtotal, shipping, total } = computeTotals(cart, tier);
      if (subtotalEl) subtotalEl.textContent = fmt(subtotal);
      if (shippingEl) shippingEl.textContent = shipping === 0 ? fmt(0) : fmt(shipping);
      totalEl.textContent = fmt(total);
      // Aufpreis-Anzeige neben jedem Tier-Radio
      tierCostEls.forEach((el) => {
        const tierName = el.dataset.tierCost;
        const cost = computeTotals(cart, tierName).shipping;
        el.textContent = cost === 0 ? fmt(0) : '+ ' + fmt(cost);
      });
    };

    tierRadios.forEach((r) => {
      r.addEventListener('change', () => {
        const tier = r.value;
        saveTier(tier);
        renderTotals(load(), tier);
      });
    });

    // Focus-Trap: speichere das vorher fokussierte Element, fange Tab im Drawer ab,
    // gib Fokus zurück beim Schließen.
    const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let previouslyFocused = null;
    const getFocusables = () => Array.from(drawer.querySelectorAll(FOCUSABLE)).filter((el) => !el.hidden && el.offsetParent !== null);
    const trapFocus = (e) => {
      if (e.key !== 'Tab' || drawer.dataset.open !== 'true') return;
      const focusables = getFocusables();
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const open = () => {
      previouslyFocused = document.activeElement;
      render();
      drawer.dataset.open = 'true';
      overlay.dataset.open = 'true';
      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.dataset.cartOpen = 'true';
      // Fokus nach Slide-In ins Drawer verschieben (erster fokussierbarer = Close-Button)
      setTimeout(() => {
        const first = getFocusables()[0];
        first?.focus();
      }, 120);
    };
    const close = () => {
      drawer.dataset.open = 'false';
      overlay.dataset.open = 'false';
      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.dataset.cartOpen = 'false';
      // Fokus zurück auf das Element, das den Drawer geöffnet hat
      if (previouslyFocused && typeof previouslyFocused.focus === 'function') {
        previouslyFocused.focus();
      }
      previouslyFocused = null;
    };

    // Events
    window.addEventListener('cart:open', open);
    window.addEventListener('cart:close', close);
    window.addEventListener('cart:changed', () => { if (drawer.dataset.open === 'true') render(); });
    window.addEventListener('keydown', (e) => {
      if (drawer.dataset.open !== 'true') return;
      if (e.key === 'Escape') close();
      else trapFocus(e);
    });

    // Open-Trigger (Header-Cart-Icon etc.)
    document.querySelectorAll('[data-cart-open]').forEach((btn) => {
      btn.addEventListener('click', (e) => { e.preventDefault(); open(); });
    });

    // Close-Trigger (X-Button, Overlay, Leer-Zustand-Link)
    document.querySelectorAll('[data-cart-close]').forEach((el) => {
      el.addEventListener('click', (e) => {
        // Wenn der Close-Trigger ein echter Link ist (z. B. Zum Shop), zuerst schließen, dann natürlich weiterleiten
        if (el.tagName !== 'A') e.preventDefault();
        close();
      });
    });

    // Quantity / Remove in drawer
    list.addEventListener('click', (e) => {
      const item = e.target.closest('[data-item]');
      if (!item) return;
      const key = item.dataset.itemKey;
      const cart = load();
      const idx = cart.findIndex((c) => (c.cartKey || c.id) === key);
      if (idx < 0) return;
      if (e.target.closest('[data-qty-increase]')) cart[idx].quantity += 1;
      else if (e.target.closest('[data-qty-decrease]')) {
        cart[idx].quantity -= 1;
        if (cart[idx].quantity <= 0) cart.splice(idx, 1);
      } else if (e.target.closest('[data-remove]')) cart.splice(idx, 1);
      else return;
      save(cart);
      render();
    });

    // Cross-tab sync
    window.addEventListener('storage', (e) => { if (e.key === 'cart') render(); });

    // Checkout
    const checkoutBtn = document.getElementById('cart-drawer-checkout');
    const errorEl = document.getElementById('cart-drawer-error');
    const agbCheck = document.getElementById('cart-agb-check');
    const labelEl = checkoutBtn?.querySelector('[data-checkout-label]');
    const loadingEl = checkoutBtn?.querySelector('[data-checkout-loading]');

    const syncCheckoutEnabled = () => {
      if (!checkoutBtn || !agbCheck) return;
      checkoutBtn.disabled = !agbCheck.checked;
    };
    agbCheck?.addEventListener('change', syncCheckoutEnabled);
    syncCheckoutEnabled();

    const setCheckoutLoading = (loading) => {
      if (!checkoutBtn) return;
      checkoutBtn.disabled = loading || !agbCheck?.checked;
      labelEl?.classList.toggle('hidden', loading);
      loadingEl?.classList.toggle('hidden', !loading);
    };
    const showError = (msg) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    };
    const hideError = () => errorEl?.classList.add('hidden');

    checkoutBtn?.addEventListener('click', async () => {
      const cart = load();
      if (cart.length === 0) return;
      hideError();
      setCheckoutLoading(true);
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lang,
            shippingTier: loadTier(),
            items: cart.map((i) => ({
              id: i.id,
              quantity: i.quantity,
              variants: i.variants || {},
              ...(i.personalization ? { personalization: i.personalization } : {}),
            })),
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.url) {
          throw new Error(data.error || checkoutErrorGeneric);
        }
        window.location.href = data.url;
      } catch (err) {
        showError(err instanceof Error ? err.message : checkoutErrorGeneric);
        setCheckoutLoading(false);
      }
    });
  })();
</script>
