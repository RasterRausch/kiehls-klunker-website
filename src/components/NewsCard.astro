---
// Sticky News-Card unten rechts (Desktop) bzw. unten quer (Mobile).
// Inhalt aus i18n (Termine als echter Text → SEO/Screenreader/Übersetzung).
// Klick auf CTA → Lightbox mit Flyer-Bild.
// X kollabiert die Card nur in-page zu einem Tab am rechten Rand;
// der nächste Page-Load startet wieder ausgefahren.
import { getLang, t } from '../i18n';

const lang = getLang(Astro);
const strings = t(lang).news;

const FLYER_SRC = '/news/maerkte-2026.webp';

// Auf Checkout-/Erfolgsseiten nicht stören.
const path = Astro.url.pathname;
const hidden = path.startsWith('/checkout') || path.startsWith('/api/');
---

{!hidden && (
  <>
    <aside
      class="news-card"
      data-news-card
      role="complementary"
      aria-label={strings.eyebrow}
      aria-hidden="true"
      inert
    >
      <button
        type="button"
        class="news-card__close"
        data-news-close
        aria-label={strings.closeLabel}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/>
          <line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="news-card__body"
        data-news-open
        aria-label={strings.cta}
      >
        <div class="news-card__text">
          <span class="news-card__eyebrow">{strings.eyebrow}</span>
          <span class="news-card__headline">{strings.headline}</span>
          <ul class="news-card__dates">
            {strings.dates.map((d) => (
              <li>
                <span class="news-card__date">{d.date}</span>
                <span class="news-card__sep"> · </span>
                <span class="news-card__loc">{d.location}</span>
              </li>
            ))}
          </ul>
          <span class="news-card__cta link-arrow">{strings.cta}<span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </button>
    </aside>

    <button
      type="button"
      class="news-tab"
      data-news-tab
      aria-label={strings.expandLabel}
      aria-hidden="true"
      inert
    >
      <svg class="news-tab__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <polyline points="15 6 9 12 15 18" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="news-tab__text">{strings.eyebrow}</span>
    </button>

    <button
      type="button"
      class="news-lightbox__backdrop"
      data-news-lightbox-backdrop
      aria-label={strings.flyerLightboxClose}
      hidden
    ></button>
    <div
      class="news-lightbox"
      data-news-lightbox
      role="dialog"
      aria-modal="true"
      aria-label={strings.flyerAlt}
      hidden
    >
      <button
        type="button"
        class="news-lightbox__close"
        data-news-lightbox-close
        aria-label={strings.flyerLightboxClose}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/>
          <line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
        </svg>
      </button>
      <img class="news-lightbox__img" src={FLYER_SRC} alt={strings.flyerAlt} />
    </div>

    <script is:inline>
      (() => {
        const card = document.querySelector('[data-news-card]');
        const tab = document.querySelector('[data-news-tab]');
        const lightbox = document.querySelector('[data-news-lightbox]');
        if (!card || !tab || !lightbox) return;

        const setState = (state) => {
          // state: 'expanded' | 'collapsed'
          document.body.classList.toggle('news-expanded', state === 'expanded');
          document.body.classList.toggle('news-collapsed', state === 'collapsed');
          const cardActive = state === 'expanded';
          const tabActive = state === 'collapsed';
          card.setAttribute('aria-hidden', String(!cardActive));
          tab.setAttribute('aria-hidden', String(!tabActive));
          if (cardActive) card.removeAttribute('inert'); else card.setAttribute('inert', '');
          if (tabActive) tab.removeAttribute('inert'); else tab.setAttribute('inert', '');
        };

        // Anfangs sind beide off-screen (CSS-Default). Nach kurzem Delay
        // ausfahren — das erzeugt das Slide-in. Kein Persist-Mechanismus:
        // Jede Seitenladung startet ausgefahren.
        window.setTimeout(() => setState('expanded'), 600);

        const close = card.querySelector('[data-news-close]');
        close?.addEventListener('click', () => setState('collapsed'));

        tab.addEventListener('click', () => setState('expanded'));

        const openBtn = card.querySelector('[data-news-open]');
        const closeLightbox = lightbox.querySelector('[data-news-lightbox-close]');

        const backdrop = document.querySelector('[data-news-lightbox-backdrop]');

        const openLightbox = () => {
          lightbox.hidden = false;
          if (backdrop) backdrop.hidden = false;
          requestAnimationFrame(() => {
            lightbox.classList.add('is-open');
            backdrop?.classList.add('is-open');
          });
          document.body.style.overflow = 'hidden';
        };
        const hideLightbox = () => {
          lightbox.classList.remove('is-open');
          backdrop?.classList.remove('is-open');
          document.body.style.overflow = '';
          window.setTimeout(() => {
            lightbox.hidden = true;
            if (backdrop) backdrop.hidden = true;
          }, 220);
        };

        openBtn?.addEventListener('click', openLightbox);
        closeLightbox?.addEventListener('click', hideLightbox);
        backdrop?.addEventListener('click', hideLightbox);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !lightbox.hidden) hideLightbox();
        });
      })();
    </script>

    <style>
      .news-card {
        position: fixed;
        z-index: 80;
        background: var(--color-paper);
        border: 1px solid var(--color-hairline);
        box-shadow: 0 12px 40px rgba(28, 28, 26, 0.12);
        opacity: 0;
        /* Default: off-screen rechts. Mobile: über die rechte Bildschirmkante. */
        transform: translateX(calc(100% + 1.5rem));
        transition: transform 360ms cubic-bezier(0.32, 0.72, 0.24, 1), opacity 280ms ease;
        font-family: var(--font-sans);
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        max-width: none;
      }
      body.news-expanded .news-card {
        opacity: 1;
        transform: translateX(0);
      }

      @media (min-width: 640px) {
        .news-card {
          left: auto;
          right: 1.5rem;
          bottom: 1.5rem;
          width: 340px;
        }
      }

      /* Tab am rechten Bildschirmrand — sichtbar wenn die Card eingeklappt ist. */
      .news-tab {
        position: fixed;
        z-index: 80;
        right: 0;
        bottom: 1rem;
        background: var(--color-paper);
        border: 1px solid var(--color-hairline);
        border-right: none;
        padding: 0.85rem 0.55rem 0.95rem 0.65rem;
        box-shadow: -6px 8px 24px rgba(28, 28, 26, 0.1);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-sans);
        color: var(--color-ink);
        /* Default: off-screen rechts. */
        transform: translateX(100%);
        transition: transform 360ms cubic-bezier(0.32, 0.72, 0.24, 1);
      }
      body.news-collapsed .news-tab {
        transform: translateX(0);
      }
      .news-tab:hover {
        background: var(--color-bone-deep);
      }
      .news-tab:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 2px;
      }
      .news-tab__arrow {
        opacity: 0.55;
        flex-shrink: 0;
      }
      .news-tab__text {
        writing-mode: vertical-rl;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 500;
      }

      @media (min-width: 640px) {
        .news-tab {
          bottom: 1.5rem;
        }
      }

      .news-card__close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: var(--color-ink);
        cursor: pointer;
        border-radius: 4px;
        opacity: 0.6;
        transition: opacity 150ms ease, background 150ms ease;
      }
      .news-card__close:hover,
      .news-card__close:focus-visible {
        opacity: 1;
        background: var(--color-bone-deep);
      }
      .news-card__close:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 2px;
      }

      .news-card__body {
        display: block;
        padding: 0;
        text-align: left;
        border: none;
        background: transparent;
        cursor: pointer;
        width: 100%;
        font: inherit;
        color: inherit;
      }
      .news-card__body:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 2px;
      }

      .news-card__text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
        padding: 1.1rem 2.5rem 1.1rem 1.25rem;
      }

      .news-card__eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-ink-soft, var(--color-ink));
        opacity: 0.65;
        font-weight: 500;
      }

      .news-card__headline {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        line-height: 1.25;
        color: var(--color-ink);
        margin-top: 0.15rem;
      }

      .news-card__dates {
        list-style: none;
        margin: 0.5rem 0 0.55rem;
        padding: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--color-ink);
      }
      .news-card__dates li {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
      }
      .news-card__date {
        font-variant-numeric: tabular-nums;
        font-weight: 500;
      }
      .news-card__sep {
        opacity: 0.5;
      }

      .news-card__cta {
        margin-top: 0.5rem;
      }
      /* Damit Hover irgendwo auf der Card-Body den Arrow animiert
         (statt nur Hover direkt auf dem Link-Span). */
      .news-card__body:hover .news-card__cta {
        color: var(--color-gold-hover);
      }
      .news-card__body:hover .news-card__cta .arrow {
        transform: translateX(6px);
      }

      /* Lightbox: Backdrop und Bild-Frame als zwei getrennte Layer.
         So ist `.news-lightbox` *exakt* so groß wie das Bild — kein
         Container-länger-als-Bild-Effekt mehr. */
      .news-lightbox__backdrop {
        position: fixed;
        inset: 0;
        z-index: 110;
        border: none;
        padding: 0;
        background: rgba(28, 28, 26, 0.94);
        cursor: pointer;
        opacity: 0;
        transition: opacity 220ms ease;
      }
      .news-lightbox__backdrop.is-open {
        opacity: 1;
      }
      .news-lightbox {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 111;
        /* Margins matchen die Website (px-6 md:px-10): 24px mobile,
           40px desktop. Width explizit, damit der Container die ganze
           Breite einnimmt — width:auto schrumpft sonst. */
        width: calc(100vw - 3rem);
        max-width: 720px;
        max-height: calc(100vh - 3rem);
        opacity: 0;
        transition: opacity 220ms ease;
        line-height: 0;
      }
      @media (min-width: 640px) {
        .news-lightbox {
          width: calc(100vw - 5rem);
          max-height: calc(100vh - 5rem);
        }
      }
      .news-lightbox.is-open {
        opacity: 1;
      }
      .news-lightbox__img {
        display: block;
        width: 100%;
        height: auto;
        max-height: calc(100vh - 3rem);
      }
      @media (min-width: 640px) {
        .news-lightbox__img {
          max-height: calc(100vh - 5rem);
        }
      }
      .news-lightbox__close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: rgba(255, 255, 255, 0.92);
        color: var(--color-ink);
        cursor: pointer;
        border-radius: 50%;
        z-index: 1;
      }
      .news-lightbox__close:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        .news-card,
        .news-tab,
        .news-lightbox {
          transition: opacity 120ms ease;
        }
      }
    </style>
  </>
)}
