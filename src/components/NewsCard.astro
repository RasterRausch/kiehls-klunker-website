---
// Sticky News-Card unten rechts (Desktop) bzw. unten quer (Mobile).
// Inhalt aus i18n (Termine als echter Text → SEO/Screenreader/Übersetzung).
// X kollabiert die Card zu einem Tab am rechten Rand. Status bleibt
// während der Browser-Session erhalten (sessionStorage) — auch über
// Page-Wechsel hinweg. Beim nächsten Browser-Besuch wieder ausgefahren.
import { getLang, t } from '../i18n';

const lang = getLang(Astro);
const strings = t(lang).news;

// Auf Checkout-/Erfolgsseiten nicht stören.
const path = Astro.url.pathname;
const hidden = path.startsWith('/checkout') || path.startsWith('/api/');
---

{!hidden && (
  <>
    <aside
      class="news-card"
      data-news-card
      role="complementary"
      aria-label={strings.eyebrow}
      aria-hidden="true"
      inert
    >
      <button
        type="button"
        class="news-card__close"
        data-news-close
        aria-label={strings.closeLabel}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" stroke-linecap="round"/>
          <line x1="18" y1="6" x2="6" y2="18" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="news-card__body">
        <div class="news-card__text">
          <span class="news-card__eyebrow">{strings.eyebrow}</span>
          <span class="news-card__headline">{strings.headline}</span>
          <ul class="news-card__dates">
            {strings.dates.map((d) => (
              <li>
                <span class="news-card__date">{d.date}</span>
                <span class="news-card__sep"> · </span>
                <span class="news-card__loc">{d.location}</span>
                <span class="news-card__detail">{d.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </aside>

    <button
      type="button"
      class="news-tab"
      data-news-tab
      aria-label={strings.expandLabel}
      aria-hidden="true"
      inert
    >
      <svg class="news-tab__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <polyline points="15 6 9 12 15 18" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="news-tab__text">{strings.eyebrow}</span>
    </button>

    <script is:inline>
      (() => {
        const card = document.querySelector('[data-news-card]');
        const tab = document.querySelector('[data-news-tab]');
        if (!card || !tab) return;

        const setState = (state) => {
          // state: 'expanded' | 'collapsed'
          document.body.classList.toggle('news-expanded', state === 'expanded');
          document.body.classList.toggle('news-collapsed', state === 'collapsed');
          const cardActive = state === 'expanded';
          const tabActive = state === 'collapsed';
          card.setAttribute('aria-hidden', String(!cardActive));
          tab.setAttribute('aria-hidden', String(!tabActive));
          if (cardActive) card.removeAttribute('inert'); else card.setAttribute('inert', '');
          if (tabActive) tab.removeAttribute('inert'); else tab.setAttribute('inert', '');
        };

        // sessionStorage merkt sich den Collapse-Status für die Session.
        const STORAGE_KEY = 'kk_news_collapsed';
        let wasCollapsed = false;
        try { wasCollapsed = sessionStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}

        // Anfangs sind beide off-screen (CSS-Default). Nach kurzem Delay
        // den richtigen Zustand setzen — das erzeugt das Slide-in.
        window.setTimeout(() => {
          setState(wasCollapsed ? 'collapsed' : 'expanded');
        }, 600);

        const close = card.querySelector('[data-news-close]');
        close?.addEventListener('click', () => {
          setState('collapsed');
          try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
        });

        tab.addEventListener('click', () => {
          setState('expanded');
          try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}
        });
      })();
    </script>

    <style>
      .news-card {
        position: fixed;
        z-index: 80;
        background: var(--color-paper);
        border: 1px solid var(--color-hairline);
        box-shadow: 0 12px 40px rgba(28, 28, 26, 0.12);
        opacity: 0;
        /* Default: off-screen rechts. Mobile: über die rechte Bildschirmkante. */
        transform: translateX(calc(100% + 1.5rem));
        transition: transform 360ms cubic-bezier(0.32, 0.72, 0.24, 1), opacity 280ms ease;
        font-family: var(--font-sans);
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        max-width: none;
      }
      body.news-expanded .news-card {
        opacity: 1;
        transform: translateX(0);
      }

      @media (min-width: 640px) {
        .news-card {
          left: auto;
          right: 1.5rem;
          bottom: 1.5rem;
          width: 340px;
        }
      }

      /* Tab am rechten Bildschirmrand — sichtbar wenn die Card eingeklappt ist. */
      .news-tab {
        position: fixed;
        z-index: 80;
        right: 0;
        bottom: 1rem;
        background: var(--color-paper);
        border: 1px solid var(--color-hairline);
        border-right: none;
        padding: 0.85rem 0.55rem 0.95rem 0.65rem;
        box-shadow: -6px 8px 24px rgba(28, 28, 26, 0.1);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-sans);
        color: var(--color-ink);
        /* Default: off-screen rechts. */
        transform: translateX(100%);
        transition: transform 360ms cubic-bezier(0.32, 0.72, 0.24, 1);
      }
      body.news-collapsed .news-tab {
        transform: translateX(0);
      }
      .news-tab:hover {
        background: var(--color-bone-deep);
      }
      .news-tab:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 2px;
      }
      .news-tab__arrow {
        opacity: 0.55;
        flex-shrink: 0;
      }
      .news-tab__text {
        writing-mode: vertical-rl;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 500;
      }

      @media (min-width: 640px) {
        .news-tab {
          bottom: 1.5rem;
        }
      }

      .news-card__close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: var(--color-ink);
        cursor: pointer;
        border-radius: 4px;
        opacity: 0.6;
        transition: opacity 150ms ease, background 150ms ease;
      }
      .news-card__close:hover,
      .news-card__close:focus-visible {
        opacity: 1;
        background: var(--color-bone-deep);
      }
      .news-card__close:focus-visible {
        outline: 2px solid var(--color-ink);
        outline-offset: 2px;
      }

      .news-card__text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
        padding: 1.1rem 2.5rem 1.1rem 1.25rem;
      }

      .news-card__eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-ink-soft, var(--color-ink));
        opacity: 0.65;
        font-weight: 500;
      }

      .news-card__headline {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        line-height: 1.25;
        color: var(--color-ink);
        margin-top: 0.15rem;
      }

      .news-card__dates {
        list-style: none;
        margin: 0.5rem 0 0.55rem;
        padding: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--color-ink);
      }
      .news-card__dates li {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
      }
      .news-card__dates li + li {
        margin-top: 0.5rem;
      }
      .news-card__date {
        font-variant-numeric: tabular-nums;
        font-weight: 500;
      }
      .news-card__sep {
        opacity: 0.5;
      }

      .news-card__detail {
        flex-basis: 100%;
        font-size: 0.8rem;
        line-height: 1.4;
        opacity: 0.7;
      }

      @media (prefers-reduced-motion: reduce) {
        .news-card,
        .news-tab {
          transition: opacity 120ms ease;
        }
      }
    </style>
  </>
)}
